diff --git a/src/libretro/cartucho_link.cpp b/src/libretro/cartucho_link.cpp
new file mode 100644
index 0000000..1e19245
--- /dev/null
+++ b/src/libretro/cartucho_link.cpp
@@ -0,0 +1,70 @@
+// Cartucho extension: lets the frontend start a network link session (cable,
+// wireless adapter or GB serial over TCP, the same protocol as the desktop
+// VBA-M) in the libretro core. Plain C exports, looked up with dlsym; every
+// call must come from the thread that runs retro_run().
+#include <cstring>
+#include <string>
+
+#include "core/gba/gbaLink.h"
+
+extern "C" {
+
+// mode: 0 = GBA cable, 1 = GBA wireless adapter, 2 = Game Boy cable.
+// players: total, server included (2-4; Game Boy is always 2).
+// host: the server to join (client only). Returns a ConnectionState:
+// 0 connected, 1 error, 2 still connecting (call cartucho_link_poll).
+__attribute__((visibility("default")))
+int cartucho_link_start(int mode, int server, int players, const char* host, int port,
+                        int timeout_ms) {
+    static const LinkMode kModes[] = {LINK_CABLE_SOCKET, LINK_RFU_SOCKET, LINK_GAMEBOY_SOCKET};
+    if (mode < 0 || mode > 2)
+        return LINK_ERROR;
+    if (mode == 2)
+        players = 2;
+    if (players < 2)
+        players = 2;
+    if (players > 4)
+        players = 4;
+    CloseLink();
+    IP_LINK_PORT = static_cast<uint16_t>(port);
+    IP_LINK_BIND_ADDRESS = "*";
+    SetLinkTimeout(timeout_ms);
+    EnableSpeedHacks(false);
+    EnableLinkServer(server != 0, players - 1);
+    if (!server && (!host || !SetLinkServerHost(host)))
+        return LINK_ERROR;
+    return InitLink(kModes[mode]);
+}
+
+// Advances a connection in progress. Writes a status line ("Waiting for
+// clients 1/2...", "Connected as #2"...) into message. Same return values.
+__attribute__((visibility("default")))
+int cartucho_link_poll(char* message, int size) {
+    if (size > 0)
+        message[0] = '\0';
+    return ConnectLinkUpdate(message, static_cast<size_t>(size));
+}
+
+// Once per frame while a session is up: notices dropped peers.
+__attribute__((visibility("default")))
+void cartucho_link_frame() {
+    if (GetLinkMode() != LINK_DISCONNECTED)
+        CheckLinkConnection();
+}
+
+__attribute__((visibility("default")))
+int cartucho_link_active() {
+    return GetLinkMode() != LINK_DISCONNECTED;
+}
+
+__attribute__((visibility("default")))
+int cartucho_link_player_id() {
+    return GetLinkPlayerId();
+}
+
+__attribute__((visibility("default")))
+void cartucho_link_stop() {
+    CloseLink();
+}
+
+}  // extern "C"
