 static unsigned serialize_size = 0;
 
+// Cartucho: extra state after the core's own, behind a marker so states
+// without it still load.
+//  - GBA: the event scheduler (IRQ delivery, halt wake-up, HBlank DMA, SIO)
+//    is not part of CPUWriteState; without it a loaded state resumes with
+//    stale or missing events, which run-ahead and rewind (a load every
+//    frame) turn into freezes.
+//  - GB: the picture being drawn. A frame ends a little after VBlank, so
+//    the next one shows the lines drawn before the save; without them they
+//    would come from whatever was on screen before loading.
+static constexpr uint32_t kCartuchoSchedMagic = 0x44484353;  // "SCHD"
+static constexpr uint32_t kCartuchoPixMagic = 0x32585047;    // "GPX2"
+size_t gbCartuchoHiddenSize();
+void gbCartuchoHiddenSave(uint8_t* out);
+void gbCartuchoHiddenLoad(const uint8_t* in);
+static size_t CartuchoPixBytes()
+{
+    return g_pix ? (size_t)systemWidth * systemHeight * (systemColorDepth >> 3) : 0;
+}
+static size_t CartuchoSchedBytes()
+{
+    if (type == IMAGE_GBA)
+        return 4 + gbaScheduler::SaveStateSize();
+    if (type == IMAGE_GB && CartuchoPixBytes())
+        return 12 + CartuchoPixBytes() + gbCartuchoHiddenSize();
+    return 0;
+}
