 size_t retro_serialize_size(void)
 {
     if (!core)
@@ -1852,25 +1881,82 @@ size_t retro_serialize_size(void)
     if (enable_variable_serialization_size) {
         serialize_size = core->emuWriteState(serializationBuffer);
     }
-    return serialize_size;
+    return serialize_size + CartuchoSchedBytes();
 }
 
 bool retro_serialize(void* data, size_t size)
 {
     if (!core)
         return false;
-    if (size == serialize_size)
-        return core->emuWriteState((uint8_t*)data);
-    if (enable_variable_serialization_size)
-        return core->emuWriteState((uint8_t*)data);
-    return false;
+    const size_t extra = CartuchoSchedBytes();
+    if (size < extra)
+        return false;
+    if (size - extra != serialize_size && !enable_variable_serialization_size)
+        return false;
+    const unsigned written = core->emuWriteState((uint8_t*)data);
+    if (!written)
+        return false;
+    if (extra) {
+        // At the very end, where retro_unserialize looks for it.
+        uint8_t* tail = (uint8_t*)data + size - extra;
+        if (type == IMAGE_GBA) {
+            memcpy(tail, &kCartuchoSchedMagic, 4);
+            gbaScheduler::SaveState(tail + 4);
+        } else {
+            const uint32_t bytes = (uint32_t)CartuchoPixBytes();
+            const uint32_t hidden = (uint32_t)gbCartuchoHiddenSize();
+            memcpy(tail, &kCartuchoPixMagic, 4);
+            memcpy(tail + 4, &bytes, 4);
+            memcpy(tail + 8, &hidden, 4);
+            memcpy(tail + 12, g_pix, bytes);
+            gbCartuchoHiddenSave(tail + 12 + bytes);
+        }
+    }
+    return true;
 }
 
 bool retro_unserialize(const void* data, [[maybe_unused]] size_t size)
 {
     if (!core)
         return false;
-    return core->emuReadState((uint8_t*)data);
+    if (type == IMAGE_GB) {
+        // The GB loader resets the machine before reading; a state it then
+        // rejects (another format, a GB state on GBC) would leave the game
+        // reset. Keep the running state to put back.
+        static std::vector<uint8_t> before;
+        before.resize(serializationBufferSize);
+        const unsigned kept = core->emuWriteState(before.data());
+        if (!core->emuReadState((uint8_t*)data)) {
+            if (kept)
+                core->emuReadState(before.data());
+            return false;
+        }
+        const size_t extra = CartuchoSchedBytes();
+        if (extra && size >= extra) {
+            const uint8_t* tail = (const uint8_t*)data + size - extra;
+            uint32_t magic = 0, bytes = 0, hidden = 0;
+            memcpy(&magic, tail, 4);
+            memcpy(&bytes, tail + 4, 4);
+            memcpy(&hidden, tail + 8, 4);
+            if (magic == kCartuchoPixMagic && bytes == CartuchoPixBytes() &&
+                hidden == gbCartuchoHiddenSize()) {
+                memcpy(g_pix, tail + 12, bytes);
+                gbCartuchoHiddenLoad(tail + 12 + bytes);
+            }
+        }
+        return true;
+    }
+    if (!core->emuReadState((uint8_t*)data))
+        return false;
+    const size_t extra = CartuchoSchedBytes();
+    if (extra && size >= extra) {
+        const uint8_t* tail = (const uint8_t*)data + size - extra;
+        uint32_t magic = 0;
+        memcpy(&magic, tail, 4);
+        if (magic == kCartuchoSchedMagic)
+            gbaScheduler::LoadState(tail + 4);
+    }
+    return true;
 }
 
 void retro_cheat_reset(void)
